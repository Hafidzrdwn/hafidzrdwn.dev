---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Logo from '../components/icons/Logo.astro';
import GithubIcon from '../components/icons/GithubIcon.astro';
import { getCollection } from 'astro:content';

// Fetch all projects defined in Markdown collections
const rawProjects = await getCollection('projects');

// Sort by order ascending
const projects = rawProjects.sort((a, b) => a.data.order - b.data.order);

// Format projects for Schema.org JSON-LD structured data
const seoProjects = projects.map(p => ({
  title: p.data.title,
  description: p.data.description,
  url: p.data.url,
}));

const currentYear = new Date().getFullYear();
---

<Layout projects={seoProjects}>
  <main>
    <!-- Top Navigation / Identity Bar -->
    <header class="site-header">
      <div class="brand-group">
        <a href="/" class="brand-link" aria-label="Hafidz Ridwan Cahya Home">
          <Logo size={46} />
          <div class="brand-text">
            <span class="brand-name">Hafidz Ridwan Cahya</span>
            <span class="brand-role">Full-Stack Web Developer</span>
          </div>
        </a>
      </div>

      <div class="header-actions">
        <div class="availability-badge" title="Open for collaboration and projects">
          <span class="beacon-pulse"></span>
          <span>Open to Projects</span>
        </div>
        <a 
          href="https://github.com/Hafidzrdwn" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="icon-btn" 
          aria-label="GitHub Profile Hafidz Ridwan"
        >
          <GithubIcon size={20} />
        </a>
      </div>
    </header>

    <div class="divider-line"></div>

    <!-- Bio / About Section -->
    <section class="bio-section" aria-labelledby="about-heading">
      <div class="terminal-card">
        <div class="card-bar">
          <div class="window-controls">
            <span class="control red"></span>
            <span class="control yellow"></span>
            <span class="control green"></span>
          </div>
          <span class="card-bar-title font-mono" id="about-heading">[ ~/about-me.md ]</span>
          <span class="location-pill font-mono">📍 Surabaya, ID</span>
        </div>

        <div class="terminal-body">
          <p class="bio-intro">
            Halo! Saya <strong>Hafidz Ridwan Cahya</strong>, seorang Full-Stack Web Developer. 
            Fokus utama saya mencakup eksplorasi <strong>Frontend</strong> dan <strong>Backend</strong> modern, 
            didukung ketertarikan mendalam pada <strong>Software Infrastructure & DevOps</strong>.
          </p>
          <p class="bio-sub">
            Saat ini, saya aktif menempuh studi <em>undergraduate</em> program studi <strong>Sistem Informasi</strong> Semester 7 di <strong>UPN "Veteran" Jawa Timur</strong>.
          </p>

          <div class="skill-chips">
            <span class="skill-tag">#Frontend</span>
            <span class="skill-tag">#Backend</span>
            <span class="skill-tag">#SoftwareArchitecture</span>
            <span class="skill-tag">#DataAnalysis</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Directory Section -->
    <section class="projects-section" aria-labelledby="directory-heading">
      <div class="section-headline">
        <div class="headline-text">
          <h2 id="directory-heading">Directory of Projects</h2>
          <p>
            Kumpulan tautan mini proyek, utilitas, dan eksplorasi web development yang telah dibangun:
          </p>
        </div>

        <!-- Filter Buttons (UX-First) -->
        <div class="filter-bar" role="tablist" aria-label="Filter Proyek">
          <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">
            Semua ({projects.length})
          </button>
          <button class="filter-btn" data-filter="featured" role="tab" aria-selected="false">
            Featured
          </button>
          <button class="filter-btn" data-filter="tool" role="tab" aria-selected="false">
            Tools
          </button>
        </div>
      </div>

      <!-- Project Grid -->
      <div class="projects-grid" id="projects-grid">
        {projects.map((project) => {
          const isTool = project.data.category.toLowerCase().includes('tool') || 
                         project.data.tags.some(t => t.toLowerCase().includes('tool') || t.toLowerCase().includes('calc'));
          return (
            <div 
              class="project-item" 
              data-featured={project.data.featured ? 'true' : 'false'}
              data-is-tool={isTool ? 'true' : 'false'}
            >
              <ProjectCard 
                title={project.data.title}
                description={project.data.description}
                url={project.data.url}
                category={project.data.category}
                tags={project.data.tags}
                featured={project.data.featured}
                status={project.data.status}
                badge={project.data.badge}
              />
            </div>
          );
        })}
      </div>
    </section>

    <div class="divider-line"></div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-top">
        <div class="footer-credits">
          <p class="last-updated font-mono">
            Last Updated: Oktober {currentYear}
          </p>
        </div>
        <div class="footer-links">
          <a href="https://github.com/Hafidzrdwn" target="_blank" rel="noopener noreferrer" class="footer-link">
            GitHub
          </a>
          <span class="sep">•</span>
          <a href="https://www.linkedin.com/in/hafidzrdwn/" target="_blank" rel="noopener noreferrer" class="footer-link">
            LinkedIn
          </a>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {currentYear} <strong>Hafidz Ridwan Cahya</strong>. All rights reserved.</p>
      </div>
    </footer>
  </main>
</Layout>

<script>
  // Simple, instant UX filter without reloading or framework bloat
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectItems = document.querySelectorAll<HTMLElement>('.project-item');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // Toggle active states
      filterButtons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach(item => {
        if (filter === 'all') {
          item.style.display = 'block';
        } else if (filter === 'featured') {
          item.style.display = item.dataset.featured === 'true' ? 'block' : 'none';
        } else if (filter === 'tool') {
          item.style.display = item.dataset.isTool === 'true' ? 'block' : 'none';
        }
      });
    });
  });
</script>

<style>
  /* Header Section */
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .brand-group {
    display: flex;
    align-items: center;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .brand-role {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-emerald);
  }

  .beacon-pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
    animation: beacon 2s infinite ease-in-out;
  }

  @keyframes beacon {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.75; }
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-focus);
    background-color: var(--bg-surface-hover);
    transform: translateY(-1px);
  }

  .divider-line {
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border-subtle), transparent);
    margin: 1.5rem 0 2.25rem;
  }

  /* Terminal Card (Bio) */
  .bio-section {
    margin-bottom: 2.75rem;
  }

  .terminal-card {
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: border-color 0.2s ease;
  }

  .terminal-card:hover {
    border-color: rgba(56, 189, 248, 0.25);
  }

  .card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid var(--border-subtle);
    gap: 0.75rem;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .control {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .control.red { background: #ef4444; opacity: 0.8; }
  .control.yellow { background: #eab308; opacity: 0.8; }
  .control.green { background: #22c55e; opacity: 0.8; }

  .card-bar-title {
    font-size: 0.8rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .location-pill {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .terminal-body {
    padding: 1.5rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .bio-intro, .bio-sub {
    font-size: 0.98rem;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .bio-intro strong, .bio-sub strong {
    color: #ffffff;
    font-weight: 600;
  }

  .bio-intro em, .bio-sub em {
    color: var(--accent-cyan);
    font-style: normal;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-accent);
  }

  /* Projects Directory */
  .projects-section {
    margin-bottom: 3rem;
  }

  .section-headline {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .headline-text {
    max-width: 500px;
  }

  .headline-text h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface);
    padding: 0.25rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .filter-btn {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: var(--text-primary);
  }

  .filter-btn.active {
    background: var(--bg-elevated);
    color: var(--accent-cyan);
    font-weight: 600;
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Workflow Note */
  .workflow-note {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: rgba(56, 189, 248, 0.05);
    border: 1px dashed rgba(56, 189, 248, 0.25);
  }

  .note-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .note-content {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .note-content code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: var(--accent-cyan);
    font-size: 0.8rem;
  }

  /* Footer */
  .site-footer {
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .footer-credits {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .attribution {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .attribution a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  .last-updated {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-link {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .footer-link:hover {
    color: var(--accent-cyan);
  }

  .sep {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1.25rem;
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    main {
      padding: 2rem 1rem 3rem;
    }
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .header-actions {
      width: 100%;
      justify-content: space-between;
    }
    .section-headline {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .filter-bar {
      width: 100%;
      justify-content: stretch;
    }
    .filter-btn {
      flex: 1;
      text-align: center;
    }
    .footer-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
