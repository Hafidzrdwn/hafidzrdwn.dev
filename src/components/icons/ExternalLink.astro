---
interface Props {
  size?: number;
  class?: string;
}

const { size = 16, class: className = "" } = Astro.props;
---

<svg 
  xmlns="http://www.w3.org/2000/svg" 
  width={size} 
  height={size} 
  viewBox="0 0 24 24" 
  fill="none" 
  stroke="currentColor" 
  stroke-width="2" 
  stroke-linecap="round" 
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M7 17l9.2-9.2M17 17V7H7"/>
</svg>
